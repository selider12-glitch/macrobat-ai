# Configuración del Backend de Macrobat AI

# Copia este archivo como .env y reemplaza los valores por tus credenciales reales

# API Key de Google Gemini (obligatoria para el chat)
GEMINI_API_KEY=

# Google Custom Search API (necesario para Deep Search)
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Orígenes adicionales permitidos para CORS (opcional, separados por comas)
CORS_ALLOWED_ORIGINS=
